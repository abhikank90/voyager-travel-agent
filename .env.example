# ============================================
# VOYAGER TRAVEL AGENT - Environment Variables
# ============================================

# ────────────────────────────────────────────
# REQUIRED ✅ - System will NOT work without this
# ────────────────────────────────────────────

# Anthropic Claude API Key (Get from: https://console.anthropic.com)
# Used for: Intent parsing, collaboration analysis, itinerary generation, all AI features
# Cost: ~$0.05-0.15 per query
ANTHROPIC_API_KEY=sk-ant-your-key-here


# ────────────────────────────────────────────
# OPTIONAL - All have realistic mock fallbacks
# ────────────────────────────────────────────

# Amadeus Flight API (Get from: https://developers.amadeus.com)
# Test API is FREE - Provides real flight data
# If not set: Uses mock flight data (realistic prices/routes)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Booking.com API via RapidAPI (Get from: https://rapidapi.com/apidojo/api/booking-com)
# Subscription required - Provides real hotel data
# If not set: Uses mock hotel data (realistic prices/ratings)
BOOKING_API_KEY=

# OpenWeather API (Get from: https://openweathermap.org/api)
# Free tier: 1000 calls/day - Provides real weather forecasts
# If not set: Uses climate averages (historical data)
OPENWEATHER_API_KEY=


# ────────────────────────────────────────────
# OPTIONAL - LangSmith Tracing (Debugging)
# ────────────────────────────────────────────

# LangSmith for debugging and observability (Get from: https://smith.langchain.com)
# Shows detailed traces of all agent calls, token usage, and latency
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=voyager-travel-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ────────────────────────────────────────────
# AWS (Production Deployment)
# ────────────────────────────────────────────

# AWS Credentials (for DynamoDB user profiles in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DYNAMODB_TABLE=voyager-user-profiles


# ────────────────────────────────────────────
# SECURITY - API Protection
# ────────────────────────────────────────────

# Voyager API Key (for protecting your API endpoints)
# If not set: Authentication is DISABLED (development mode only)
# In production: Generate a strong random key (e.g., openssl rand -hex 32)
# Usage: Include "X-API-Key: your-key-here" header in all API requests
VOYAGER_API_KEY=

# Allowed Origins for CORS (comma-separated list of frontend URLs)
# Development default: http://localhost:5173,http://localhost:3000
# Production: Set to your actual frontend domain (e.g., https://yourdomain.com)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ────────────────────────────────────────────
# APP CONFIGURATION
# ────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# ============================================
# QUICK START 
# ============================================
#
# MINIMUM SETUP (Development - No Auth):
# 1. Copy this file: cp .env.example .env
# 2. Get Anthropic API key: https://console.anthropic.com
# 3. Add your key to the ANTHROPIC_API_KEY line in .env
# 4. Leave VOYAGER_API_KEY empty (auth disabled in dev mode)
# 5. Run: uvicorn api.main:app --reload
# 6. Open frontend: cd frontend && npm run dev
#
# PRODUCTION SETUP (With Auth):
# 1. Generate API key: openssl rand -hex 32
# 2. Set VOYAGER_API_KEY in .env
# 3. Set ALLOWED_ORIGINS to your frontend domain
# 4. All API requests must include X-API-Key header
#
# That's it! Everything else uses mock data automatically.
#
# ============================================
# EXTERNAL API SUMMARY
# ============================================
#
# API                  Required?  Cost         Mock Fallback?
# ─────────────────────────────────────────────────────────
# Anthropic Claude     ✅ YES     ~$0.10/query  ❌ No
# Amadeus Flights      ❌ No      Free         ✅ Yes
# Booking.com Hotels   ❌ No      Varies       ✅ Yes
# OpenWeather          ❌ No      Free tier    ✅ Yes
# DuckDuckGo Search    ❌ No      Free         ✅ Yes (built-in)
#
# See API_REQUIREMENTS.md for detailed documentation.
#
