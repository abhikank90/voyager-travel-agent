# ============================================
# Voyager Travel Agent - .gitignore
# ============================================

# ────────────────────────────────────────────
# Benchmark data (local only — not for VCS)
# ────────────────────────────────────────────
metrics/sessions.jsonl

# ────────────────────────────────────────────
# Environment Variables (CRITICAL - Contains API keys)
# ────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
*.env

# ────────────────────────────────────────────
# Python
# ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ────────────────────────────────────────────
# Testing & Coverage
# ────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage_report/
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/

# ────────────────────────────────────────────
# Virtual Environments
# ────────────────────────────────────────────
venv/
ENV/
env/
.venv
.pyenv

# ────────────────────────────────────────────
# IDEs & Editors
# ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# ────────────────────────────────────────────
# Frontend / Node.js
# ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.cache/
.parcel-cache/
.next/
out/

# ────────────────────────────────────────────
# Logs
# ────────────────────────────────────────────
*.log
logs/
*.log.*

# ────────────────────────────────────────────
# Database & Storage
# ────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
qdrant_data/

# ────────────────────────────────────────────
# Docker
# ────────────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ────────────────────────────────────────────
# OS Files
# ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ────────────────────────────────────────────
