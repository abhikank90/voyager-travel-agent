[run]
source = agents,graph,api,config
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */env/*
    */.venv/*
    */node_modules/*
    */frontend/*
    */scripts/*
    */infra/*

[report]
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    pass

[html]
directory = coverage_report/html

[xml]
output = coverage_report/coverage.xml

[json]
output = coverage_report/coverage.json
